# 复制为 .env 后填写；GitHub Actions 中配置为 Secret，名称 NEWAPI_ACCOUNTS
# 值必须是 JSON 数组；url 可省略（默认 https://sunapi.5201201314.top），name 为日志备注
# 单账号
NEWAPI_ACCOUNTS=[{"login_username":"你的用户名","login_password":"你的密码","name":"账号1"}]

# 多账号
# NEWAPI_ACCOUNTS=[{"login_username":"a@example.com","login_password":"密码1","name":"账号1"},{"login_username":"b@example.com","login_password":"密码2","name":"账号2"}]
